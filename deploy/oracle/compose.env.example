# Copy this file to compose.env, replace every CHANGE_ME value, then run deploy.sh.
# compose.env is ignored by Git and must remain readable only by its owner.
CUSTOM_IMAGE=ghcr.io/jbx123159/autoflow-360
CUSTOM_TAG=CHANGE_ME_IMAGE_TAG
PULL_POLICY=always
AUTOFLOW_PLATFORM=linux/arm64

DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD
SITE_NAME=CHANGE_ME.example.com
FRAPPE_SITE_NAME_HEADER=CHANGE_ME.example.com

LETSENCRYPT_EMAIL=CHANGE_ME@example.com
SITES_RULE=Host(`CHANGE_ME.example.com`)
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

GUNICORN_THREADS=2
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=20m
RESTART_POLICY=unless-stopped
